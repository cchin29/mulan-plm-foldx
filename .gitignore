# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
.eggs/
.installed.cfg
MANIFEST

# --- Environments ---
.env
.venv
.venv-*/
env/
venv/
ENV/

# --- Tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
