# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
.claude/

# --- Working area ---------------------------------------------------------
# `scratch/` is the local, machine-specific working tree: per-run training
# outputs and checkpoints, PLM embedding caches, FoldX work dirs, and queue
# driver scripts. Everything in it is either regenerable from tracked code or
# published deliberately under data/ and results/.
scratch/
log/
cache/
notebooks/

# Large binaries that are downloaded or produced, not versioned.
*.tar.gz
*.pt
*.ckpt
*.h5

# ...but data/ and results/ ARE the published artifacts. Nothing under them is generated
# incidentally; each file is there deliberately (see data/README.md).
!data/**
!results/**

# Upstream pretrained checkpoints are NOT redistributed by this fork; if you
# download them from upstream they land here and stay untracked.
# (models/config/*.json — the small head configs — ARE tracked.)
models/pretrained/

# foldenv's structural-context disk cache. `.struct_context_cache/` is the pre-extraction
# name, kept so an existing working tree stays clean.
.foldenv_cache/
.struct_context_cache/

# CATH leakage analysis: large, re-downloadable reference files.
experiments/cath_leakage/cath-domain-list.txt
experiments/cath_leakage/pdb_chain_cath_uniprot.csv.gz

# Session transcripts / export dumps — never source.
snapshot*.md
export*.md

# Deck bundles and staging dirs (regenerable from the deck sources).
scripts_plots/artifacts/**/*_selfcontained.html
scripts_plots/artifacts/**/_to_delete/

# Per-box generated aggregates (each machine regenerates from its own runs).
scripts_plots/benchmarks_folds.csv
experiments/embedding_sweep/results/*@*.json

# The CATH-superfamily split is built locally, never redistributed -- it joins onto a third-party
# partition (see data/splits/splits_skempi_full_cath_kfold/README.md and NOTICE). These are the
# builder's outputs. They stay untracked so a local rebuild cannot be committed back, which the
# `!data/**` rule above would otherwise allow.
data/splits/splits_skempi_full_cath_kfold/fold_0/
data/splits/splits_skempi_full_cath_kfold/test_single.tsv
data/splits/splits_skempi_full_cath_kfold/test_multiple.tsv
data/splits/splits_skempi_full_cath_kfold/JOIN_REPORT.txt

# Generated by scripts_plots/check_fig1_numbers.py and plot_fishbone.py. They ship as scripts, not
# as outputs: a provenance sidecar that ships is one more thing that can go stale against the
# numbers it claims to source, which is the failure these two scripts exist to catch.
scripts_plots/fig1_provenance.txt
scripts_plots/fishbone_provenance.txt
scripts_plots/fishbone.svg
scripts_plots/fishbone.png
